        "U_W_m2K"       : 18.0,   # reduced HTC at high P due to dense gas
    },
}

# ──────────────────────────────────────────────────────────────────────────
# 4. HEAT DUTY CALCULATION FUNCTIONS
# ──────────────────────────────────────────────────────────────────────────

def calc_heat_duty(vap: dict, T_amb_C: float) -> dict:
    """
    Q_total = Q_sensible_liquid  (warming LNG from -162°C to boiling point)
            + Q_latent           (vaporisation)
            + Q_superheat        (warming vapour to outlet temp)

    Returns duty in kW and MJ/h.
    """
    mdot_kgs = vap["flow_rate_kg_h"] / 3600.0   # kg/s

    T_boil_K  = LNG_INLET_TEMP_K              # approx inlet = boiling point
    T_out_K   = outlet_temp_K(T_amb_C)

    # Sensible heat of liquid phase (LNG warming to boiling) – small here
    # because LNG enters already near saturation; kept for completeness
    T_liq_warm = 5.0  # K   (small sub-cooling)
    CP_liq     = 3.5  # kJ/(kg·K) liquid LNG specific heat
    Q_liq_sens = mdot_kgs * CP_liq * T_liq_warm   # kW

    # Latent heat
    Q_latent   = mdot_kgs * LNG_LATENT_HEAT_kJ_kg  # kW

    # Superheat (vapour from boiling point to outlet temp)
    delta_T_superheat = T_out_K - T_boil_K         # K
    Q_superheat = mdot_kgs * CP_GAS_kJ_kgK * delta_T_superheat  # kW

    Q_net  = Q_liq_sens + Q_latent + Q_superheat
    Q_design = Q_net * vap["safety_factor"]

    # LMTD-based area check
    # Hot side = ambient air;  Cold side = LNG/NG
    dT1 = (T_amb_C + 273.15) - T_boil_K          # at LNG inlet
    dT2 = (T_amb_C + 273.15) - T_out_K            # at NG outlet
    if dT1 <= 0:
        dT1 = 0.5   # clamp to avoid math domain error in extreme winter
    if dT2 <= 0:
        dT2 = 0.5
    if abs(dT1 - dT2) < 0.01:
        LMTD = dT1
    else:
        LMTD = (dT1 - dT2) / math.log(dT1 / dT2)

    U_kW  = vap["U_W_m2K"] / 1000.0               # kW/(m²·K)
    A_required_m2 = Q_design / (U_kW * LMTD) if LMTD > 0 else float("inf")

    return {
        "Q_sensible_liq_kW"  : round(Q_liq_sens,   2),
        "Q_latent_kW"        : round(Q_latent,      2),
        "Q_superheat_kW"     : round(Q_superheat,   2),
        "Q_net_kW"           : round(Q_net,         2),
        "Q_design_kW"        : round(Q_design,      2),
        "Q_design_MJ_h"      : round(Q_design * 3.6, 2),
        "T_outlet_C"         : round(T_out_K - 273.15, 1),
        "LMTD_K"             : round(LMTD,          2),
        "A_required_m2"      : round(A_required_m2, 2),
        "A_provided_m2"      : vap["fin_area_m2"],
        "area_adequate"      : A_required_m2 <= vap["fin_area_m2"],
    }


# ──────────────────────────────────────────────────────────────────────────
# 5. FROSTING RISK ASSESSMENT  (critical for atmospheric vaporisers)
# ──────────────────────────────────────────────────────────────────────────

def frost_risk(T_amb_C: float, rel_humidity: float, Q_kW: float) -> str:
    """
    Simple frost index: if fin surface temperature drops below 0°C
    AND humid air, frosting occurs, reducing HTC over time.
    """
    # Approximate fin surface temperature using simplified resistance model
    # T_fin ≈ T_amb - (Q / (U * A)) expressed as fraction of driving force
    # For AAV, fin tip approaches LNG temperature
    T_fin_approx = -30.0  # conservative estimate for fin root region (°C)
    dew_point_approx = T_amb_C - ((100 - rel_humidity * 100) / 5.0)

    if T_fin_approx < 0 and dew_point_approx > T_fin_approx:
        return "HIGH – Frost accumulation expected; de-icing / duty-standby rotation required"
    elif T_fin_approx < 0:
        return "MEDIUM – Sub-zero fins; monitor for light frost"
    else:
        return "LOW – No significant frost expected"


