    },
}

# ──────────────────────────────────────────────────────────────────────────
# 2. LNG / NG PROCESS CONDITIONS  (from P&ID line specs & equipment tags)
# ──────────────────────────────────────────────────────────────────────────
LNG_INLET_TEMP_C   = -162.0          # °C  (LNG saturation temp at ~1 bar)
LNG_INLET_TEMP_K   = LNG_INLET_TEMP_C + 273.15

# Outlet NG temperature is typically set to (T_amb - 10°C) minimum
# We enforce a floor of +5 °C for safety
def outlet_temp_K(T_amb_C):
    return max(T_amb_C - 10.0, 5.0) + 273.15

# LNG / NG thermal properties (representative values for pure methane basis)
LNG_LATENT_HEAT_kJ_kg   = 509.0   # kJ/kg  vaporisation heat at ~1 bar
CP_GAS_kJ_kgK           = 2.23    # kJ/(kg·K) avg Cp of NG (superheating phase)
LNG_DENSITY_kg_m3       = 430.0   # kg/m³  (LNG in storage)

# ──────────────────────────────────────────────────────────────────────────
# 3. VAPORISER STAGE DEFINITIONS  (from P&ID pressure specs & line services)
# ──────────────────────────────────────────────────────────────────────────
#
#  LP Vaporiser : Low-pressure regasification (city gas / domestic supply)
#  MP Vaporiser : Medium-pressure (industrial / CNG mother station inlet)
#  HP Vaporiser : High-pressure (LCNG dispenser / HP compression inlet)
#
VAPORISERS = {
    "LP_Vaporiser": {
        "label"         : "LP Vaporiser (Low Pressure)",
        "inlet_press_barg": 4.0,
        "outlet_press_barg": 3.5,
        "flow_rate_kg_h": 500.0,   # kg/h  design throughput
        "safety_factor" : 1.15,    # 15 % margin
        "fin_area_m2"   : 180.0,   # effective heat-transfer area (fins)
        "U_W_m2K"       : 25.0,    # Overall HTC for AAV (W/m²·K) – typical
    },
    "MP_Vaporiser": {
        "label"         : "MP Vaporiser (Medium Pressure)",
        "inlet_press_barg": 18.0,
        "outlet_press_barg": 17.0,
        "flow_rate_kg_h": 1000.0,
