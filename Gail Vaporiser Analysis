    "Summer": {
        "T_amb_C": 42.0,          # °C  (peak summer DBT)
        "T_amb_K": 42.0 + 273.15,
        "relative_humidity": 0.30, # 30 %
        "wind_speed_mps": 1.5,    # m/s
    },
    "Winter": {
        "T_amb_C": 4.0,           # °C  (typical winter DBT)
        "T_amb_K": 4.0 + 273.15,
