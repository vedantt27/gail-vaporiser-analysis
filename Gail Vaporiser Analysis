        separator("─")

        for vap_key, vap in VAPORISERS.items():
            res = calc_heat_duty(vap, T_amb)
            frost = frost_risk(T_amb, RH, res["Q_design_kW"])

            print(f"\n  ┌─ {vap['label']}")
            print(f"  │  Inlet Pressure  : {vap['inlet_press_barg']} barg")
            print(f"  │  Outlet Pressure : {vap['outlet_press_barg']} barg")
            print(f"  │  LNG Flow Rate   : {vap['flow_rate_kg_h']} kg/h")
            print(f"  │  LNG Inlet Temp  : {LNG_INLET_TEMP_C} °C")
            print(f"  │  NG Outlet Temp  : {res['T_outlet_C']} °C")
            print(f"  │")
            print(f"  │  Heat Duty Breakdown:")
            print(f"  │    Sensible (liquid) : {res['Q_sensible_liq_kW']:>9.2f}  kW")
            print(f"  │    Latent (vaporise) : {res['Q_latent_kW']:>9.2f}  kW")
            print(f"  │    Superheat (vapour): {res['Q_superheat_kW']:>9.2f}  kW")
            print(f"  │    ─────────────────────────────")
            print(f"  │    Net Duty          : {res['Q_net_kW']:>9.2f}  kW")
            print(f"  │    Design Duty (×{vap['safety_factor']:.2f}): {res['Q_design_kW']:>9.2f}  kW  ({res['Q_design_MJ_h']} MJ/h)")
            print(f"  │")
            print(f"  │  Heat Transfer Analysis:")
            print(f"  │    LMTD              : {res['LMTD_K']:>9.2f}  K")
            print(f"  │    Overall HTC (U)   : {vap['U_W_m2K']:>9.1f}  W/(m²·K)")
            print(f"  │    Area Required     : {res['A_required_m2']:>9.2f}  m²")
            print(f"  │    Area Provided     : {res['A_provided_m2']:>9.1f}  m²")
            print(f"  │    Area Check        : {'✓ ADEQUATE' if res['area_adequate'] else '✗ UNDERSIZED – increase fin area!'}")
            print(f"  │")
            print(f"  │  Frost Risk          : {frost}")
            print(f"  └{'─'*65}")

            summary_table.append({
                "Season"  : season,
                "Vaporiser": vap_key,
                "Q_net_kW": res["Q_net_kW"],
                "Q_des_kW": res["Q_design_kW"],
                "A_req_m2": res["A_required_m2"],
                "OK"      : "✓" if res["area_adequate"] else "✗",
            })

        print()

    # ── Compact Summary Table ──────────────────────────────────────────────
    separator()
    print(f"\n  {'SUMMARY TABLE':^74}")
    separator("─")
    hdr = f"  {'Season':<8} {'Vaporiser':<20} {'Q_net (kW)':<14} {'Q_design (kW)':<16} {'A_req (m²)':<13} Status"
    print(hdr)
    separator("─")
    for r in summary_table:
        print(f"  {r['Season']:<8} {r['Vaporiser']:<20} {r['Q_net_kW']:<14.2f} {r['Q_des_kW']:<16.2f} {r['A_req_m2']:<13.2f} {r['OK']}")
    separator()
    print()

    # ── Design Recommendations ─────────────────────────────────────────────
    print("  DESIGN RECOMMENDATIONS")
    separator("─")
    print("""
  1. DUTY-STANDBY ROTATION:
     Atmospheric vaporisers accumulate frost (ice) on fins, reducing heat
     transfer over time. Implement 2-on / 1-standby rotation every 4-6 hrs
     during winter or high-humidity periods.

  2. CAPACITY DERATING IN WINTER:
     At 8°C ambient, driving ΔT is significantly lower than summer (42°C),
     leading to larger required heat-transfer area. Verify installed fin
     area meets winter Q_design figures above.

  3. HP VAPORISER SPECIAL CARE:
     At 200 barg, dense-phase NG has lower Cp variability; confirm U-value
     experimentally. Add a minimum outlet temperature controller (TIC) to
     prevent cold gas from reaching dispenser nozzles.

  4. OUTLET TEMPERATURE:
     Per IS/IGC standards, NG leaving vaporiser should be ≥ +5°C before
     entering pressure regulators to avoid hydrate formation.

  5. SAFETY RELIEF:
     Each vaporiser must have a PSV/SRV as shown in P&ID. Confirm SRV set
     points match line class ratings (SS1/SS3/SS6/CS1 per legend sheet).
  """)
    separator()


